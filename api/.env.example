# Server Configuration
PORT=3000
JWT_SECRET=your_super_secure_jwt_secret_here

# Database Configuration
# Ensure you use a Production PostgreSQL Connection set for DB_HOST/USER etc if not using default
PGUSER=postgres
PGHOST=localhost
PGDATABASE=paysmart
PGPASSWORD=root
PGPORT=5432

# Daraja Configuration (MPESA)
# Set to 'production' for Live payments.
DARAJA_ENV=production 
DARAJA_CONSUMER_KEY=your_live_consumer_key
DARAJA_CONSUMER_SECRET=your_live_consumer_secret
DARAJA_PASSKEY=your_live_passkey
DARAJA_SHORTCODE=your_live_paybill_or_till
DARAJA_CALLBACK_URL=https://your-public-domain.com/api/callbacks/mpesa

# Note: DARAJA_SHORTCODE should be the Paybill logic if using CustomerPayBillOnline transaction type.
